{
  "ci": {
    "collect": {
      "startServerCommand": "bun run preview",
      "startServerReadyPattern": "Accepting connections|localhost|ready",
      "url": [
        "http://localhost:3000/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}