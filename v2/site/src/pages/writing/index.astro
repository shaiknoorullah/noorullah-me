---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
---

<Base
  title="Writing — Shaik Noorullah"
  description="Field notes on platform engineering: substrate over rent, multi-agent leverage, and the public record."
  canonical="/writing"
>
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="idx">—</span>
        <span class="lbl">WRITING</span>
        <span class="rule"></span>
      </div>
      <div>
        {posts.map((post) => (
          <a class="writing-row hairline-t py-10" href={`/writing/${post.id}/`}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-2">
              <div class="min-w-0">
                <p class="meta mb-3 text-bone-2">{fmtDate(post.data.date)}</p>
                <h2 class="d3 row-title">{post.data.title}</h2>
                <p class="mt-3 max-w-[56ch] text-bone-1">{post.data.description}</p>
              </div>
              <span class="meta read-cue shrink-0 text-signal">READ →</span>
            </div>
          </a>
        ))}
        <div class="hairline-t"></div>
      </div>
    </div>
  </section>
</Base>
